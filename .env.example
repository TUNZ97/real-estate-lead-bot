# =============================================================================
# PrimeHomes Realty — Real Estate Lead Bot
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=primehomes-lead-bot
DEBUG=true

# --- Database (MySQL — local install on your PC) ---
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# Create the database first, e.g.: CREATE DATABASE primehomes_lead_bot CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/primehomes_lead_bot

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth / Security ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- n8n (npm / local) ---
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/customer-message
N8N_WEBHOOK_SECRET=

# --- AI Provider ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# --- Frontend (Vite) ---
# Prefer relative path so Vite proxy works: /api/v1
VITE_API_BASE_URL=/api/v1

# --- Optional / Observability ---
LOG_LEVEL=INFO
SENTRY_DSN=
